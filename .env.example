# Copy to backend/.env and fill in. Never commit .env.

# --- Engine -------------------------------------------------------------
# auto = use ml/engine/api.py when it imports, else example JSON from backend/fake
# real = never fall back (set this for the demo); fake = always example JSON
ENGINE_MODE=auto

# --- CORS (comma-separated; http://localhost:3000 is always allowed) -----
CORS_ORIGINS=

# --- Speech-to-text (voice notes) ---------------------------------------
# Set ONE key. First one found wins: SARVAM, then GROQ, then OPENAI.
SARVAM_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# Language the farmer speaks: mr or hi
STT_LANGUAGE=mr
# Optional model override (defaults: saarika:v2.5 / whisper-large-v3 / whisper-1)
STT_MODEL=

# --- WhatsApp: QR-linked Node bridge (backend/whatsapp/bridge) -----------
# Read by the Node process, not by FastAPI.
BACKEND_URL=http://localhost:8000
# Digits only with country code, comma-separated. Empty = reply to nobody.
ALLOWED_NUMBERS=

# --- WhatsApp: official Cloud API (backend/whatsapp/cloud_api.py) --------
# Leave empty if you use the Node bridge.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0
# Digits only with country code, comma-separated. Empty = reply to nobody.
WHATSAPP_ALLOWED_NUMBERS=

# --- WhatsApp: 360dialog sandbox (backend/whatsapp_adapter.py, POST /webhook) ---
WA_PROVIDER=
D360_API_KEY=
# GROQ_API_KEY (above) transcribes voice notes with whisper-large-v3

# --- Supabase copy for browsing (backend/supabase_load.py); Session pooler URI ---
SUPABASE_DB_URL=
